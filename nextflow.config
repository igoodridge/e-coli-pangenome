outputDir = 'results'
workflow.output.mode = 'copy'

executor {
    name = 'local'
    cpus = 64          // global cap; Prokka at 4 cpus → 16 genomes at once
}

process {
    maxRetries    = 2
    errorStrategy = 'retry'

    withName: SEQKIT_STATS               { conda = "${projectDir}/envs/seqkit.yml";  cpus = 16 }
    withName: 'DOWNLOAD_CHECKM2_DB|CHECKM2' { conda = "${projectDir}/envs/checkm2.yml" }
    withName: CHECKM2                    { cpus = 64 }
    withName: 'DOWNLOAD_SKANI_DB|SKANI_SEARCH' { conda = "${projectDir}/envs/skani.yml" }
    withName: SKANI_SEARCH               { cpus = 64 }
    withName: QC_FILTER                  { conda = "${projectDir}/envs/qc.yml" }
    withName: ANNOTATE                   { conda = "${projectDir}/envs/prokka.yml";  cpus = 4 }
    withName: PANGENOME                  { conda = "${projectDir}/envs/panaroo.yml"; cpus = 64 }
    withName: TRANSLATE                  { conda = "${projectDir}/envs/emboss.yml" }
    withName: 'DOWNLOAD_EGGNOG_DB|EGGNOG' { conda = "${projectDir}/envs/eggnog.yml" }
    withName: EGGNOG                     { cpus = 64 }
}

conda {
    enabled  = true
    cacheDir = "${System.getenv('HOME')}/.nextflow-conda-cache"
}

// Stop pip --user packages in ~/.local leaking into the conda envs
env.PYTHONNOUSERSITE = '1'

profiles {
    // Paths on the VM
    vm {
        params.input         = '/mnt/volume_1/data/strubi/ecoli_assemblies'
        params.eggnog_db     = '/mnt/volume_1/data/databases/eggnog'
        params.extra_genomes = '/home/isabelle/repos/strubi-collab/ncbi_dataset/data/GCF_000005845.2/GCF_000005845.2_ASM584v2_genomic.fna'
        params.checkm2_db    = '/mnt/volume_1/data/databases/checkm2_db/CheckM2_database/uniref100.KO.1.dmnd'
        params.skani_db      = '/mnt/volume_1/data/databases/gtdb/skani_gtdb_r226-v0.3'
    }

    // Reuse the QC reports already generated on the VM instead of rerunning seqkit, CheckM2 and skani
    vm_reports {
        params.qc_seqkit     = '/home/isabelle/repos/strubi-collab/results/qc/seqkit_stats_out.tsv'
        params.qc_checkm2    = '/mnt/volume_1/data/strubi/checkm2_out/quality_report.tsv'
        params.qc_skani      = '/home/isabelle/repos/strubi-collab/results/skani_results.tsv'
    }


    test {
        params.test_n = 3
        outputDir     = 'results_test'
        process {
            withName: 'PANGENOME|EGGNOG|CHECKM2|SKANI_SEARCH' { cpus = 8 }
        }
    }
}

manifest {
    name            = 'e-coli-pangenome'
    description     = 'E. coli pangenome: Prokka → Panaroo → transeq → eggNOG-mapper'
    nextflowVersion = '>=25.10'
}
